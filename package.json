{
  "name": "adk-url-shortener",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "db:migrate": "wrangler d1 migrations apply DB --local"
  },
  "dependencies": {
    "hono": "4.13.17",
    "primereact": "10.9.9",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.67.0",
    "vite": "8.3.6",
    "wrangler": "4.158.0",
    "@cloudflare/workers-types": "5.20261107.1",
    "@types/node": "24.19.2",
    "typescript": "7.0.2"
  }
}
